para (var i = 1; i <= 3; i = i + 1) {
    var nome = leia("Nome: ")
    var ano_nascimento = inteiro(leia("Ano de nascimento: "))
    var salario = leia("Salario: ")
    var resposta = leia("Voce usa oculos? Responda V ou F: ")

    var usa_oculos = falso

    se (resposta == 'V') {
        usa_oculos = verdadeiro
    }

    var idade = 2026 - ano_nascimento

    se (usa_oculos) {
        escreva("OK, você usa óculos!")
        escreva(nome + " tem " + texto(idade) + " anos, ganha R$ " + texto(salario) + " e usa oculos")
    } senao {
        escreva("Que pena! Você não usa óculos!")
        escreva(nome + " tem " + texto(idade) + " anos, ganha R$ " + texto(salario) + " e nao usa oculos")
    }
}
